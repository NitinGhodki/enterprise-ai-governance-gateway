{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "type": "stat",
      "title": "Total LLM Requests",
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{uri=\"/api/v1/chat\"}[24h]))",
          "legendFormat": "24h total"
        }
      ]
    },
    {
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "type": "stat",
      "title": "Cache Hit Rate",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "red",   "value": null },
            { "color": "yellow","value": 0.3 },
            { "color": "green", "value": 0.6 }
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/chat\",outcome=\"SUCCESS\"}[5m])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/chat\"}[5m]))",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "type": "stat",
      "title": "Governance Violations (24h)",
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow","value": 1 },
            { "color": "red",   "value": 10 }
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{uri=\"/api/v1/chat\",status=\"422\"}[24h]))",
          "legendFormat": "violations"
        }
      ]
    },
    {
      "id": 4,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "type": "stat",
      "title": "Rate Limited Requests (24h)",
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow","value": 5 },
            { "color": "red",   "value": 50 }
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{uri=\"/api/v1/chat\",status=\"429\"}[24h]))",
          "legendFormat": "rate limited"
        }
      ]
    },
    {
      "id": 5,
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "type": "stat",
      "title": "JVM Heap Used",
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "unit": "bytes",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 209715200 },
            { "color": "red",    "value": 283115520 }
          ]
        }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "heap"
        }
      ]
    },
    {
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "type": "timeseries",
      "title": "LLM Request Latency (p50 / p95 / p99)",
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{uri=\"/api/v1/chat\"}[5m])) by (le)) * 1000",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=\"/api/v1/chat\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=\"/api/v1/chat\"}[5m])) by (le)) * 1000",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "type": "timeseries",
      "title": "Request Rate by Outcome",
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table" }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/chat\",outcome=\"SUCCESS\"}[5m]))",
          "legendFormat": "success"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/chat\",status=\"429\"}[5m]))",
          "legendFormat": "rate_limited"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/chat\",status=\"422\"}[5m]))",
          "legendFormat": "governance_blocked"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/chat\",status=~\"5..\"}[5m]))",
          "legendFormat": "server_errors"
        }
      ]
    },
    {
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "type": "timeseries",
      "title": "JVM Memory — Heap vs Non-Heap",
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "heap used"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "heap max"
        },
        {
          "expr": "jvm_memory_used_bytes{area=\"nonheap\"}",
          "legendFormat": "nonheap used"
        }
      ]
    },
    {
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "type": "timeseries",
      "title": "Netty Event Loop — Active Connections",
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "reactor_netty_connection_provider_active_connections",
          "legendFormat": "active"
        },
        {
          "expr": "reactor_netty_connection_provider_pending_connections",
          "legendFormat": "pending"
        },
        {
          "expr": "reactor_netty_connection_provider_max_connections",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 10,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "type": "table",
      "title": "HTTP Endpoint Summary",
      "options": {
        "sortBy": [{ "displayName": "Count", "desc": true }]
      },
      "targets": [
        {
          "expr": "sum by (uri, method, status) (increase(http_server_requests_seconds_count[1h]))",
          "legendFormat": "{{method}} {{uri}} {{status}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": {} }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["ai", "governance", "spring-boot"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Enterprise AI Governance Gateway",
  "uid": "ai-governance-gateway-v1",
  "version": 1
}